rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    // Catch-all to deny all access by default
    match /{document=**} {
      allow read, write: if false;
    }

    // Rules for analysisHistory collection
    match /analysisHistory/{document} {
      // Read access: Must be authenticated and only access own documents
      allow read: if request.auth != null && resource.data.userId == request.auth.uid;
      
      // Create access: Must be authenticated, write own userId, and match exact schema keys
      allow create: if request.auth != null 
        && request.resource.data.userId == request.auth.uid
        && request.resource.data.keys().hasOnly(['userId', 'model', 'createdAt', 'processingTime', 'segmentCount', 'cleaningRatio']);

      // Update access: Denied (History entries are immutable)
      allow update: if false;

      // Delete access: Must be authenticated and own the document
      allow delete: if request.auth != null && resource.data.userId == request.auth.uid;
    }
  }
}
